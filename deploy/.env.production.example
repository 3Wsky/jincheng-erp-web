NODE_ENV=production

# 如果现有 fzlsaas 仍使用 Node 22，在宝塔为 ERP 单独安装 Node 24，填写其 node 绝对路径。
# 留空时使用当前 SSH 环境中的 node，不要为了 ERP 强制替换其他项目的 Node 版本。
ERP_NODE_BIN=

# 宝塔 Nginx 对外域名，多个来源使用英文逗号分隔。
WEB_ORIGIN=https://erp.example.com

# PM2 本机端口；默认不直接暴露公网。
WEB_PORT=3001
API_PORT=3101
API_BASE_URL=http://127.0.0.1:3101/api/v1

# 使用宝塔 PostgreSQL 中为锦程 ERP 单独创建的数据库和账号。
# 密码中的 @、:、/、# 等字符需要进行 URL 编码。
DATABASE_URL=postgresql://jincheng_erp:replace_with_url_encoded_password@127.0.0.1:5432/jincheng_erp

REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace_with_at_least_32_random_characters
CATALOG_WRITE_KEY=replace_with_a_different_random_secret

# 管家婆文件由受控同步或人工安全上传到服务器 shared/data，不进入 GitHub。
GRASP_CDS_FILE=/www/wwwroot/our/jincheng-erp/shared/data/table_m.cds

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=jincheng-erp
