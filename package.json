{
  "name": "jincheng-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "db:validate": "pnpm --filter @jincheng/database prisma:validate",
    "db:generate": "pnpm --filter @jincheng/database prisma:generate"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "^6.0.3"
  }
}
