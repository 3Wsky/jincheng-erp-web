generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  LEAVING
  INACTIVE
}

enum WarehouseType {
  COMPANY
  STORE
  PERSONAL
  AFTER_SALES
  ABNORMAL
}

enum SerialStatus {
  NORMAL
  LOCKED
  IN_TRANSIT
  PENDING_CONFIRM
  PERSONAL
  SOLD
  AFTER_SALES
  ABNORMAL
}

enum MovementType {
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  PERSONAL_ISSUE
  PERSONAL_RETURN
  SALE
  SALE_RETURN
  STOCK_GAIN
  STOCK_LOSS
  DAMAGE
  BORROW
  BORROW_RETURN
  AFTER_SALES_OUT
  AFTER_SALES_IN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// 调拨主单状态机(docs/12 第 2 节)
enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  EXCEPTION
  COMPLETED
  CANCELLED
}

/// 调拨明细状态:一台序列号商品一行
enum TransferLineStatus {
  PENDING
  LOCKED
  SHIPPED
  RECEIVED
  EXCEPTION
}

/// 调拨差异类型:少货/错货串号/损坏/拒收/超时未收
enum TransferExceptionType {
  MISSING
  WRONG_ITEM
  DAMAGED
  REJECTED
  TIMEOUT
}

/// 采购主单审批维度(docs/12 第 3 节:审批/付款/收货三维度独立推进)
enum PurchaseApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// 采购主单付款维度:UNPAID → PARTIALLY_PAID → PAID
enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// 采购主单收货维度:NOT_RECEIVED → PARTIALLY_RECEIVED → RECEIVED
enum PurchaseReceiptStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  RECEIVED
}

/// 盘点单状态机(docs/12 第 6 节);COUNTING/SUBMITTED/APPROVED 期间仓库封存
enum StocktakeStatus {
  DRAFT
  COUNTING
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

/// 盘点差异类型:MISSING 盘亏(账面有实盘无);UNEXPECTED 盘盈或串仓(实盘有账面无/在他仓)
enum StocktakeDifferenceType {
  MISSING
  UNEXPECTED
}

/// 个人库存单据类型(AC-F-007):领用公共库→个人仓;归还个人仓→公共库;转交个人仓→他人个人仓
enum PersonalStockType {
  ISSUE
  RETURN
  HANDOVER
}

/// 个人库存单据状态:提交即锁库,接收方确认后落位(归还/转交必须握手)
enum PersonalStockStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  CANCELLED
}

enum PersonalStockLineStatus {
  PENDING
  LOCKED
  DONE
}

enum CatalogClassificationStatus {
  PENDING
  CONFIRMED
}

enum CatalogImportStatus {
  PREVIEW
  APPLIED
  REJECTED
}

enum CatalogImportRowStatus {
  VALID
  INVALID
  APPLIED
}

model Organization {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  stores    Store[]
  employees Employee[]
  products  Product[]
  customers Customer[]
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
}

model Store {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  warehouses     Warehouse[]
  customers      Customer[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, code])
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  storeId            String?        @db.Uuid
  employeeNo         String
  name               String
  mobile             String?
  status             EmployeeStatus @default(ACTIVE)
  organization       Organization   @relation(fields: [organizationId], references: [id])
  store              Store?         @relation(fields: [storeId], references: [id])
  account            UserAccount?
  responsibleSerials SerialItem[]
  ownedCustomers     Customer[]
  personalStockFrom  PersonalStockOrder[] @relation("PersonalStockFromEmployee")
  personalStockTo    PersonalStockOrder[] @relation("PersonalStockToEmployee")
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, employeeNo])
  @@index([storeId, status])
}

model UserAccount {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @unique @db.Uuid
  username     String     @unique
  passwordHash String
  isFrozen     Boolean    @default(false)
  /// 密码最后修改时间:JWT 签发时间早于此值的令牌一律拒绝(改密/重置即吊销旧令牌)
  passwordChangedAt DateTime? @db.Timestamptz(3)
  /// 首次登录必须修改密码(新开账号与种子 admin 默认开启)
  mustChangePassword Boolean @default(false)
  employee     Employee   @relation(fields: [employeeId], references: [id])
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

/// 角色:isSystem=true 为 seed 内置角色(权限由 seed 权威管理,UI 不可改不可停用,
/// 防误改破坏钱账分离等已确认规则);自定义角色可在权限管理台创建与配权。
/// archivedAt 非空 = 已停用(不物理删除;有账号挂载的角色不可停用)。
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  isSystem    Boolean          @default(false)
  archivedAt  DateTime?        @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  code     String           @unique
  resource String
  action   String
  roles    RolePermission[]
}

model UserRole {
  userId        String      @db.Uuid
  roleId        String      @db.Uuid
  dataScope     String
  scopeConfig   Json?
  approvalLimit Decimal?    @db.Decimal(18, 2)
  user          UserAccount @relation(fields: [userId], references: [id])
  role          Role        @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  fieldPolicy  Json?
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Product {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @db.Uuid
  code                 String
  brand                String
  category             String
  modelName            String
  status               ProductStatus               @default(ACTIVE)
  classificationStatus CatalogClassificationStatus @default(CONFIRMED)
  organization         Organization                @relation(fields: [organizationId], references: [id])
  skus                 Sku[]
  importedRows         CatalogImportRow[]          @relation("ImportedProduct")
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@index([organizationId, brand, modelName])
}

model Sku {
  id                 String                @id @default(uuid()) @db.Uuid
  productId          String                @db.Uuid
  code               String                @unique
  name               String
  barcode            String?
  color              String?
  capacity           String?
  /// 零售指导价(2026-08-12 验收需求);null=未定价。批发/会员/门店价等多级价格待销售口径签字
  retailPrice        Decimal?              @db.Decimal(18, 2)
  serialManaged      Boolean               @default(false)
  status             ProductStatus         @default(ACTIVE)
  product            Product               @relation(fields: [productId], references: [id])
  barcodes           SkuBarcode[]
  externalIdentities SkuExternalIdentity[]
  serials            SerialItem[]
  movements          InventoryMovement[]
  transferLines      TransferLine[]
  personalStockLines PersonalStockLine[]
  purchaseLines      PurchaseLine[]
  importedRows       CatalogImportRow[]    @relation("ImportedSku")
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@index([productId])
  @@index([barcode])
  @@index([status, code])
}

model SkuBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  skuId     String   @db.Uuid
  value     String   @unique
  isPrimary Boolean  @default(false)
  sku       Sku      @relation(fields: [skuId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([skuId, isPrimary])
}

model SkuExternalIdentity {
  id            String              @id @default(uuid()) @db.Uuid
  skuId         String              @db.Uuid
  importBatchId String?             @db.Uuid
  sourceSystem  String
  sourceId      String
  sourcePayload Json?
  sku           Sku                 @relation(fields: [skuId], references: [id])
  importBatch   CatalogImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([sourceSystem, sourceId])
  @@index([skuId, sourceSystem])
  @@index([importBatchId])
}

model CatalogImportBatch {
  id               String                 @id @default(uuid()) @db.Uuid
  sourceSystem     String
  sourceRef        String
  sourceCapturedAt DateTime               @db.Timestamptz(3)
  contentHash      String                 @unique
  status           CatalogImportStatus    @default(PREVIEW)
  totalRows        Int
  validRows        Int
  invalidRows      Int
  uniqueSkus       Int
  warehouseCount   Int
  metadata         Json?
  appliedAt        DateTime?              @db.Timestamptz(3)
  rows             CatalogImportRow[]
  document         CatalogImportDocument?
  externalIds      SkuExternalIdentity[]
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  @@index([sourceSystem, sourceCapturedAt])
  @@index([status, createdAt])
}

model CatalogImportDocument {
  batchId   String             @id @db.Uuid
  fileName  String
  content   Bytes
  batch     CatalogImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
}

model CatalogImportRow {
  id                  BigInt                 @id @default(autoincrement())
  batchId             String                 @db.Uuid
  rowNumber           Int
  sourceSkuCode       String
  sourceName          String
  sourceWarehouseCode String?
  sourceWarehouseName String
  sourceSerial        String?
  quantity            Int                    @default(1)
  status              CatalogImportRowStatus
  errorCodes          String[]
  normalizedData      Json?
  appliedProductId    String?                @db.Uuid
  appliedSkuId        String?                @db.Uuid
  batch               CatalogImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  appliedProduct      Product?               @relation("ImportedProduct", fields: [appliedProductId], references: [id])
  appliedSku          Sku?                   @relation("ImportedSku", fields: [appliedSkuId], references: [id])
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([sourceSkuCode])
  @@index([sourceSerial])
  @@index([appliedProductId])
  @@index([appliedSkuId])
}

model Warehouse {
  id                String              @id @default(uuid()) @db.Uuid
  storeId           String?             @db.Uuid
  ownerEmployeeId   String?             @db.Uuid
  code              String              @unique
  name              String
  type              WarehouseType
  store             Store?              @relation(fields: [storeId], references: [id])
  serials           SerialItem[]
  outgoingMovements InventoryMovement[] @relation("MovementFrom")
  incomingMovements InventoryMovement[] @relation("MovementTo")
  transfersOut      TransferOrder[]     @relation("TransferFrom")
  transfersIn       TransferOrder[]     @relation("TransferTo")
  purchaseOrders    PurchaseOrder[]     @relation("PurchaseReceiving")
  stocktakes        StocktakeOrder[]
  personalStockFrom PersonalStockOrder[] @relation("PersonalStockFrom")
  personalStockTo   PersonalStockOrder[] @relation("PersonalStockTo")
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([storeId, type])
  @@index([ownerEmployeeId])
}

/// 盘点单:按仓库整仓盘点。COUNTING/SUBMITTED/APPROVED 期间该仓库封存,
/// 禁止调拨(建单/锁定/发出/接收)与采购收货入库(2026-08-12 业务确认:盘库期间不能调库)。
/// 操作人字段存 UserAccount.id,不建外键(与调拨/采购约定一致)。
model StocktakeOrder {
  id             String                @id @default(uuid()) @db.Uuid
  code           String                @unique
  warehouseId    String                @db.Uuid
  status         StocktakeStatus       @default(DRAFT)
  /// 开盘时账面在库序列号数快照(NORMAL/LOCKED/ABNORMAL,不含在途)
  snapshotCount  Int?
  remark         String?
  createdById    String                @db.Uuid
  startedAt      DateTime?             @db.Timestamptz(3)
  submittedAt    DateTime?             @db.Timestamptz(3)
  approvedById   String?               @db.Uuid
  approvedAt     DateTime?             @db.Timestamptz(3)
  rejectedReason String?
  postedAt       DateTime?             @db.Timestamptz(3)
  cancelledAt    DateTime?             @db.Timestamptz(3)
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  scans          StocktakeScan[]
  differences    StocktakeDifference[]
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@index([warehouseId, status])
  @@index([status, createdAt])
}

/// 盘点实盘扫描记录:一机一条,同一盘点单内 IMEI 去重
model StocktakeScan {
  id          String         @id @default(uuid()) @db.Uuid
  stocktakeId String         @db.Uuid
  imei        String
  /// 匹配到的账面序列号(按 IMEI 主/副匹配;系统外设备为 null)
  serialId    String?        @db.Uuid
  scannedById String         @db.Uuid
  scannedAt   DateTime       @default(now()) @db.Timestamptz(3)
  stocktake   StocktakeOrder @relation(fields: [stocktakeId], references: [id])

  @@unique([stocktakeId, imei])
  @@index([stocktakeId])
}

/// 盘点差异快照(提交时计算,驳回重盘时清除重算;非业务事实,过账后固化)
model StocktakeDifference {
  id          String                  @id @default(uuid()) @db.Uuid
  stocktakeId String                  @db.Uuid
  type        StocktakeDifferenceType
  serialId    String?                 @db.Uuid
  imei        String
  note        String?
  stocktake   StocktakeOrder          @relation(fields: [stocktakeId], references: [id])
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)

  @@index([stocktakeId, type])
}

/// 调拨主单:仓库间序列号商品调拨,双向握手(发出方/接收方分别确认)。
/// 操作人字段存 UserAccount.id,不建外键关系(与 Warehouse.ownerEmployeeId 约定一致)。
model TransferOrder {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  status          TransferStatus @default(DRAFT)
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  remark          String?
  createdById     String         @db.Uuid
  submittedAt     DateTime?      @db.Timestamptz(3)
  approvedById    String?        @db.Uuid
  approvedAt      DateTime?      @db.Timestamptz(3)
  rejectedReason  String?
  lockedAt        DateTime?      @db.Timestamptz(3)
  shippedById     String?        @db.Uuid
  shippedAt       DateTime?      @db.Timestamptz(3)
  receivedAt      DateTime?      @db.Timestamptz(3)
  completedAt     DateTime?      @db.Timestamptz(3)
  cancelledAt     DateTime?      @db.Timestamptz(3)
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines           TransferLine[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
}

/// 调拨明细:序列号商品一机一行;差异(少货/错货/损坏/拒收/超时)记录在行上
model TransferLine {
  id            String                 @id @default(uuid()) @db.Uuid
  transferId    String                 @db.Uuid
  serialId      String                 @db.Uuid
  skuId         String                 @db.Uuid
  status        TransferLineStatus     @default(PENDING)
  exceptionType TransferExceptionType?
  exceptionNote String?
  receivedById  String?                @db.Uuid
  receivedAt    DateTime?              @db.Timestamptz(3)
  transfer      TransferOrder          @relation(fields: [transferId], references: [id])
  serial        SerialItem             @relation(fields: [serialId], references: [id])
  sku           Sku                    @relation(fields: [skuId], references: [id])
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([transferId, serialId])
  @@index([serialId, status])
  @@index([transferId, status])
}

/// 个人库存单据:领用/归还/转交。提交即锁库,确认后写流水并落位。
/// 归还由库管确认,转交由接收员工确认(AC-F-007 接收方握手)。
/// 操作人字段存 UserAccount.id,不建外键(与调拨约定一致)。
model PersonalStockOrder {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique
  type            PersonalStockType
  status          PersonalStockStatus @default(DRAFT)
  fromWarehouseId String              @db.Uuid
  toWarehouseId   String              @db.Uuid
  fromEmployeeId  String?             @db.Uuid
  toEmployeeId    String?             @db.Uuid
  remark          String?
  createdById     String              @db.Uuid
  submittedAt     DateTime?           @db.Timestamptz(3)
  confirmedById   String?             @db.Uuid
  confirmedAt     DateTime?           @db.Timestamptz(3)
  cancelledAt     DateTime?           @db.Timestamptz(3)
  fromWarehouse   Warehouse           @relation("PersonalStockFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("PersonalStockTo", fields: [toWarehouseId], references: [id])
  fromEmployee    Employee?           @relation("PersonalStockFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployee      Employee?           @relation("PersonalStockToEmployee", fields: [toEmployeeId], references: [id])
  lines           PersonalStockLine[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([type, status])
  @@index([fromEmployeeId, status])
  @@index([toEmployeeId, status])
}

model PersonalStockLine {
  id               String                  @id @default(uuid()) @db.Uuid
  orderId          String                  @db.Uuid
  serialId         String                  @db.Uuid
  skuId            String                  @db.Uuid
  status           PersonalStockLineStatus @default(PENDING)
  /// 提交锁库前的序列号状态,取消时原样恢复(期初个人仓可能仍是 NORMAL)
  lockedFromStatus SerialStatus?
  order            PersonalStockOrder      @relation(fields: [orderId], references: [id])
  serial           SerialItem              @relation(fields: [serialId], references: [id])
  sku              Sku                     @relation(fields: [skuId], references: [id])
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([orderId, serialId])
  @@index([serialId, status])
  @@index([orderId, status])
}

model SerialItem {
  id                    String              @id @default(uuid()) @db.Uuid
  skuId                 String              @db.Uuid
  imeiPrimary           String              @unique
  imeiSecondary         String?             @unique
  serialNumber          String?             @unique
  currentWarehouseId    String              @db.Uuid
  responsibleEmployeeId String?             @db.Uuid
  status                SerialStatus
  unitCost              Decimal             @db.Decimal(18, 2)
  receivedAt            DateTime            @db.Timestamptz(3)
  sku                   Sku                 @relation(fields: [skuId], references: [id])
  currentWarehouse      Warehouse           @relation(fields: [currentWarehouseId], references: [id])
  responsibleEmployee   Employee?           @relation(fields: [responsibleEmployeeId], references: [id])
  movements             InventoryMovement[]
  transferLines         TransferLine[]
  personalStockLines    PersonalStockLine[]
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  @@index([skuId, status])
  @@index([currentWarehouseId, status])
  @@index([responsibleEmployeeId, status])
}

model InventoryMovement {
  id              String       @id @default(uuid()) @db.Uuid
  documentId      String       @db.Uuid
  documentType    String
  movementType    MovementType
  skuId           String       @db.Uuid
  serialId        String?      @db.Uuid
  quantity        Int
  fromWarehouseId String?      @db.Uuid
  toWarehouseId   String?      @db.Uuid
  occurredAt      DateTime     @db.Timestamptz(3)
  sku             Sku          @relation(fields: [skuId], references: [id])
  serial          SerialItem?  @relation(fields: [serialId], references: [id])
  fromWarehouse   Warehouse?   @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?   @relation("MovementTo", fields: [toWarehouseId], references: [id])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([documentId, documentType])
  @@index([skuId, occurredAt])
  @@index([serialId, occurredAt])
}

model AuditLog {
  id          BigInt       @id @default(autoincrement())
  actorUserId String?      @db.Uuid
  action      String
  resource    String
  resourceId  String
  beforeData  Json?
  afterData   Json?
  requestId   String?
  ipAddress   String?
  actor       UserAccount? @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([resource, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  occurredAt    DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  retryCount    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@index([aggregateType, aggregateId])
}

/// 供应商主档:status 复用 ProductStatus(ACTIVE/INACTIVE),停用后不可再建采购单
model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  contactName    String?
  contactPhone   String?
  status         ProductStatus   @default(ACTIVE)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, name])
}

/// 采购主单:聚合审批/付款/收货三个维度(docs/12 第 3 节),completedAt 非空 = 已完成。
/// paidAmount 是付款单据(PurchasePayment)的聚合缓存,每次付款在同一事务内累加,
/// 非手工修改(AGENTS 第 1 条:余额变化由业务单据驱动)。
/// 操作人字段(createdById/approvedById)存 UserAccount.id,不建外键(与 TransferOrder 约定一致)。
model PurchaseOrder {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique
  supplierId     String                 @db.Uuid
  warehouseId    String                 @db.Uuid
  approvalStatus PurchaseApprovalStatus @default(DRAFT)
  paymentStatus  PurchasePaymentStatus  @default(UNPAID)
  receiptStatus  PurchaseReceiptStatus  @default(NOT_RECEIVED)
  totalAmount    Decimal                @db.Decimal(18, 2)
  paidAmount     Decimal                @default(0) @db.Decimal(18, 2)
  remark         String?
  createdById    String                 @db.Uuid
  submittedAt    DateTime?              @db.Timestamptz(3)
  approvedById   String?                @db.Uuid
  approvedAt     DateTime?              @db.Timestamptz(3)
  rejectedReason String?
  completedAt    DateTime?              @db.Timestamptz(3)
  cancelledAt    DateTime?              @db.Timestamptz(3)
  supplier       Supplier               @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse              @relation("PurchaseReceiving", fields: [warehouseId], references: [id])
  lines          PurchaseLine[]
  payments       PurchasePayment[]
  receipts       PurchaseReceipt[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([approvalStatus, createdAt])
  @@index([supplierId])
}

/// 采购明细行:按 SKU + 数量下单,收货时逐台生成序列号并累加 receivedQuantity
model PurchaseLine {
  id               String                @id @default(uuid()) @db.Uuid
  purchaseOrderId  String                @db.Uuid
  skuId            String                @db.Uuid
  quantity         Int
  unitPrice        Decimal               @db.Decimal(18, 2)
  receivedQuantity Int                   @default(0)
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  sku              Sku                   @relation(fields: [skuId], references: [id])
  receiptItems     PurchaseReceiptItem[]
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([purchaseOrderId, skuId])
  @@index([skuId])
}

/// 采购付款单据:资金变化由本单据驱动(AGENTS 第 1 条),主单 paidAmount 同事务累加
model PurchasePayment {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  amount          Decimal       @db.Decimal(18, 2)
  method          String
  note            String?
  createdById     String        @db.Uuid
  paidAt          DateTime      @db.Timestamptz(3)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([purchaseOrderId, paidAt])
}

/// 采购收货批次:一次扫码收货一批,单号 RCP- 前缀
model PurchaseReceipt {
  id              String                @id @default(uuid()) @db.Uuid
  purchaseOrderId String                @db.Uuid
  code            String                @unique
  receivedById    String                @db.Uuid
  receivedAt      DateTime              @db.Timestamptz(3)
  note            String?
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseReceiptItem[]
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@index([purchaseOrderId, receivedAt])
}

/// 采购收货明细:一台序列号一行;serialId 指向收货时创建的 SerialItem,
/// 不建外键(与操作人字段约定一致,SerialItem 生命周期独立于采购单)
model PurchaseReceiptItem {
  id             String          @id @default(uuid()) @db.Uuid
  receiptId      String          @db.Uuid
  purchaseLineId String          @db.Uuid
  serialId       String          @db.Uuid
  imeiPrimary    String
  receipt        PurchaseReceipt @relation(fields: [receiptId], references: [id])
  purchaseLine   PurchaseLine    @relation(fields: [purchaseLineId], references: [id])
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([receiptId])
  @@index([purchaseLineId])
  @@index([serialId])
}

/// 回访结果枚举(REQ-PEOPLE-010,2026-08-13 已确认的 8 个标准值)
enum FollowupResult {
  NO_DEMAND
  INTERESTED
  PENDING_QUOTE
  PENDING_VISIT
  DEAL_DONE
  REFUSED_CONTACT
  INVALID_NUMBER
  FOLLOW_UP_LATER
}

/// 客户主档(AC-F-015):customer_id 全局唯一,手机号不作主键(docs/07 第 30-31 行)。
/// 去重规则待业务签字——phone 不加硬唯一约束(重复客户需可识别后受控合并),
/// 创建时同手机号返回 409 提示,显式 allowDuplicate 才放行;合并单据(customer_merge_log)待规则签字后建。
/// archivedAt 非空 = 已作废(不物理删除,AGENTS 第 4 条)。
model Customer {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  name            String
  phone           String?
  /// 来源渠道:枚举待业务确认,先存自由文本(如 门店自然到店/短视频/老客介绍)
  sourceChannel   String?
  /// 归属门店/归属销售(docs/11 数据范围 SELF/STORE 维度的基础)
  ownerStoreId    String?            @db.Uuid
  ownerEmployeeId String?            @db.Uuid
  remark          String?
  createdById     String             @db.Uuid
  archivedAt      DateTime?          @db.Timestamptz(3)
  organization    Organization       @relation(fields: [organizationId], references: [id])
  ownerStore      Store?             @relation(fields: [ownerStoreId], references: [id])
  ownerEmployee   Employee?          @relation(fields: [ownerEmployeeId], references: [id])
  identities      CustomerIdentity[]
  followups       FollowupRecord[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  @@index([organizationId, phone])
  @@index([organizationId, name])
  @@index([ownerEmployeeId])
}

/// 客户外部身份映射(REQ-CRM-001,与 SkuExternalIdentity 同构,AGENTS 第 6 条:
/// 保留原始 ID/载荷/同步批次)。企微/小程序会员接入 BLOCKED 于平台权限,
/// 本表先支撑管家婆等历史客户导入。
model CustomerIdentity {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  sourceSystem  String
  sourceId      String
  sourcePayload Json?
  syncBatchId   String?
  customer      Customer @relation(fields: [customerId], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([sourceSystem, sourceId])
  @@index([customerId, sourceSystem])
}

/// 回访记录(AC-F-016/REQ-PEOPLE-009~012):必须实名到客户与员工;
/// 同日同人同客多次记录全部保留,「有效回访人数」统计口径去重计 1(查询层处理,不丢日志);
/// nextFollowupAt 到期且其后无新回访 → 进入我的待办。
/// method(电话/微信/到店)枚举未终裁,先存自由文本。
model FollowupRecord {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @db.Uuid
  createdById    String         @db.Uuid
  method         String?
  result         FollowupResult
  note           String?
  /// 结果=有意向时建议填写:意向商品与预计购买时间(REQ-PEOPLE-010)
  intentProduct  String?
  expectedBuyAt  DateTime?      @db.Timestamptz(3)
  nextFollowupAt DateTime?      @db.Timestamptz(3)
  occurredAt     DateTime       @default(now()) @db.Timestamptz(3)
  customer       Customer       @relation(fields: [customerId], references: [id])
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@index([customerId, occurredAt])
  @@index([nextFollowupAt])
}
